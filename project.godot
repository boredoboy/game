; Engine configuration file.
; Dead Radio native desktop project — Godot 4.7.2
config_version=5

[application]
config/name="Dead Radio"
config/description="Ночной survival-шутер от первого лица"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/textures/ui/game_icon.svg"

[autoload]
GameSettings="*res://scripts/autoload/game_settings.gd"
GameManager="*res://scripts/autoload/game_manager.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/resizable=true
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.0352941, 0.0509804, 0.0588235, 1)

[physics]
3d/default_gravity=19.6

[input]
move_forward={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87)]}
move_back={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83)]}
move_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65)]}
move_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68)]}
sprint={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194325)]}
reload={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":82)]}
pause={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194305)]}
shoot={"deadzone":0.2,"events":[Object(InputEventMouseButton,"button_index":1)]}
